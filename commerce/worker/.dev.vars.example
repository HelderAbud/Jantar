# Copie para .dev.vars (gitignored) — NUNCA commitar valores reais.
# Cloudflare: wrangler secret put MP_ACCESS_TOKEN

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PRO_TOKEN=JL-PRO-DEMO
CHECKOUT_AMOUNT_CENTAVOS=200
PUBLIC_APP_ORIGIN=http://127.0.0.1:5177
