# Copie para .env.instagram e preencha LOCALMENTE.
# .env.instagram está no .gitignore — NÃO commitar, NÃO colar no chat, NÃO pedir para a IA ler.

# Público / ok compartilhar no chat (só o @):
INSTAGRAM_HANDLE=@basicmodaeacessorios
# Alvo futuro, se livre: @jantarlink

# Marca comercial (opcional, só lembrete local no .env.instagram):
# INSTAGRAM_DISPLAY_NAME=Jantar Link

# NUNCA coloque senha neste arquivo .example (ele pode ir pro Git).
# Senha, se precisar anotar, só em .env.instagram (gitignored) — e nunca peça à IA para ler.

# Opcional no .env.instagram (privado):
# INSTAGRAM_PASSWORD=
# INSTAGRAM_LOGIN_EMAIL=
# INSTAGRAM_BIO_LINK_STAGING=
# INSTAGRAM_BIO_LINK_PROD=https://helderabud.github.io/Jantar/
